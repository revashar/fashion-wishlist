<div class="wishlist-section">
  <div class="wishlist-header">
    <h2>{{title}}</h2>
    {{#if currentUser}}
      <a href="/add-item" class="add-btn">Add New Item</a>
    {{/if}}
  </div>

  {{#if wishlist.length}}
    <!-- Filters -->
    <div class="wishlist-filters">
      <label>
        Color
        <select id="filter-color">
          <option value="">All</option>
          {{#each options.allColors}}
            <option value="{{this}}" {{#ifEquals ../filters.color this}}selected{{/ifEquals}}>{{this}}</option>
          {{/each}}
        </select>
      </label>

      <label>
        Category
        <select id="filter-category">
          <option value="">All</option>
          {{#each options.allCategories}}
            <option value="{{this}}" {{#ifEquals ../filters.category this}}selected{{/ifEquals}}>{{this}}</option>
          {{/each}}
        </select>
      </label>

      <label>
        Season
        <select id="filter-season">
          <option value="">All</option>
          {{#each options.allSeasons}}
            <option value="{{this}}" {{#ifEquals ../filters.season this}}selected{{/ifEquals}}>{{this}}</option>
          {{/each}}
        </select>
      </label>

      <label>
        Brand
        <select id="filter-brand">
          <option value="">All</option>
          {{#each options.allBrands}}
            <option value="{{this}}" {{#ifEquals ../filters.brand this}}selected{{/ifEquals}}>{{this}}</option>
          {{/each}}
        </select>
      </label>

      <button id="apply-filters" class="filter-btn">Apply Filters</button>
      <button id="reset-filters" class="reset-btn">Reset Filters</button>
    </div>

    <ul class="wishlist-items" id="wishlist-items">
      {{#each wishlist}}
	{{> item-card this showAddButton=false showDeleteButton=true}}
      {{/each}}
    </ul>

  {{else}}
    <p class="empty">This wishlist is currently empty.</p>
  {{/if}}
</div>
