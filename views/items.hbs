<div class="wishlist-section">
  <div class="wishlist-header">
    <h2>All Items</h2>

    {{#if user}}
      <a href="/add-item" class="add-btn">Add New Item</a>
    {{/if}}
  </div>

  {{#if items.length}}

    <!-- Filters -->
    <div class="wishlist-filters">
      <label>
        Color
        <select id="filter-color">
          <option value="">All</option>
          {{#each options.allColors}}
            <option value="{{this}}" {{#ifEquals ../filters.color this}}selected{{/ifEquals}}>
              {{this}}
            </option>
          {{/each}}
        </select>
      </label>

      <label>
        Category
        <select id="filter-category">
          <option value="">All</option>
          {{#each options.allCategories}}
            <option value="{{this}}" {{#ifEquals ../filters.category this}}selected{{/ifEquals}}>
              {{this}}
            </option>
          {{/each}}
        </select>
      </label>

      <label>
        Season
        <select id="filter-season">
          <option value="">All</option>
          {{#each options.allSeasons}}
            <option value="{{this}}" {{#ifEquals ../filters.season this}}selected{{/ifEquals}}>
              {{this}}
            </option>
          {{/each}}
        </select>
      </label>

      <label>
        Brand
        <select id="filter-brand">
          <option value="">All</option>
          {{#each options.allBrands}}
            <option value="{{this}}" {{#ifEquals ../filters.brand this}}selected{{/ifEquals}}>
              {{this}}
            </option>
          {{/each}}
        </select>
      </label>

      <button id="apply-filters" class="filter-btn">Apply Filters</button>
      <button id="reset-filters" class="reset-btn">Reset Filters</button>
    </div>

    <!-- Item list -->
    <ul class="wishlist-items" id="wishlist-items">
      {{#each items}}
        <li class="wishlist-item" id="item-{{this._id}}"
            data-color="{{this.color}}"
            data-category="{{this.category}}"
            data-season="{{this.season}}"
            data-brand="{{this.brandName}}">
          
          <!-- Render the generic item card partial -->
          {{> item-card this}}

          <!-- Inline Add to Wishlist button or badge (only on All Items page) -->
          {{#if ../user}}
            <div class="item-actions-inline">
              {{#if (includes ../user.wishlist this._id)}}
                <span class="wishlist-badge">Already in wishlist</span>
              {{else}}
                <button class="add-wishlist-btn" data-item-id="{{this._id}}">
                  Add to wishlist
                </button>
              {{/if}}
            </div>
          {{/if}}

        </li>
      {{/each}}
    </ul>

  {{else}}
    <p class="empty">No items available.</p>
  {{/if}}
</div>

<!-- Scripts -->
<script src="/js/wishlistFilters.js"></script>
<script src="/js/addToWishlist.js"></script>
