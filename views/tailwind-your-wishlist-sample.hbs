<h2 class="text-2xl font-bold mb-4">{{title}}</h2>

<!-- Wishlist Items as Cards -->
<ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
  {{#each user.wishlist}}
    <li class="bg-gray-800 p-4 rounded shadow text-gray-100 hover:bg-gray-700 transition">
      <p class="font-semibold mb-2">{{this.name}}</p>
      <a href="{{this.link}}" target="_blank" class="text-blue-400 hover:underline">View Item</a>
    </li>
  {{/each}}
</ul>

<!-- Add New Item Button -->
<a href="/add-item" class="inline-block mt-6 px-6 py-2 bg-blue-600 text-white rounded hover:bg-blue-500 transition">
  Add New Item
</a>
